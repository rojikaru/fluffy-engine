# LLM provider: ollama (default) | docker | openai
LLM_PROVIDER=ollama
# Optional overrides for the provider selected above
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3.5:9b
# LLM_API_KEY=

# Used by the openai provider when LLM_API_KEY is not set
# OPENAI_API_KEY=

# Torch device for the embedding models: cuda | cpu (default: cuda when available).
# On an 8 GB GPU shared with a local LLM, run the app with cpu.
# TORCH_DEVICE=cpu

# Hosted Chroma; without these a local ./chroma directory is used
# CHROMA_SERVER_HOST=
# CHROMA_AUTH_TOKEN_TRANSPORT_HEADER=
# CHROMA_CLIENT_AUTH_PROVIDER=
# CHROMA_CLIENT_AUTH_CREDENTIALS=
